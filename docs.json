{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Launchpoint",
  "description": "Use the Public API to build with Launchpoint's verified creator marketing data.",
  "colors": {
    "primary": "#00A5EF",
    "light": "#40BCF3",
    "dark": "#0B86D9"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "LP Display",
      "source": "https://www.launchpointhq.com/assets/lp-display.woff2",
      "format": "woff2",
      "weight": 480
    },
    "body": {
      "family": "Geist",
      "source": "https://www.launchpointhq.com/assets/geist.woff2",
      "format": "woff2",
      "weight": 450
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.jpeg",
  "navigation": {
    "tabs": [
      {
        "tab": "Public API",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "mcp",
              "creator-deals"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "api-reference/openapi.json",
              "directory": "api-reference/v1"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/launchpoint-tile.svg",
    "dark": "/logo/launchpoint-tile.svg",
    "href": "https://www.launchpointhq.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Visit website",
        "href": "https://www.launchpointhq.com"
      },
      {
        "label": "Get support",
        "href": "mailto:hi@launchpointhq.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Go to dashboard",
      "href": "https://dashboard.launchpointhq.com"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "footer": {
    "socials": {
      "instagram": "https://instagram.com/launchpoint"
    }
  }
}
