{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Launchpoint",
  "colors": {
    "primary": "#7733E1",
    "light": "#7733E1",
    "dark": "#7733E1"
  },
  "favicon": "/favicon.jpeg",
  "navigation": {
    "tabs": [
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "api-reference/introduction",
              "api-reference/campaigns/overview",
              "api-reference/campaigns/webhooks"
            ]
          },
          {
            "group": "Campaigns",
            "pages": [
              "api-reference/campaigns/list",
              "api-reference/campaigns/create",
              "api-reference/campaigns/get",
              "api-reference/campaigns/update",
              "api-reference/campaigns/delete"
            ]
          },
          {
            "group": "Lifecycle",
            "pages": [
              "api-reference/campaigns/publish",
              "api-reference/campaigns/pause",
              "api-reference/campaigns/resume",
              "api-reference/campaigns/complete"
            ]
          },
          {
            "group": "Tasks",
            "pages": [
              "api-reference/campaigns/list-tasks",
              "api-reference/campaigns/create-task",
              "api-reference/campaigns/update-task",
              "api-reference/campaigns/archive-task"
            ]
          },
          {
            "group": "Creators",
            "pages": [
              "api-reference/campaigns/list-creators",
              "api-reference/campaigns/approve-creator",
              "api-reference/campaigns/reject-creator"
            ]
          },
          {
            "group": "Submissions",
            "pages": [
              "api-reference/campaigns/list-submissions",
              "api-reference/campaigns/get-submission",
              "api-reference/campaigns/approve-submission",
              "api-reference/campaigns/reject-submission"
            ]
          },
          {
            "group": "Reporting",
            "pages": ["api-reference/campaigns/list-posts", "api-reference/campaigns/metrics"]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@launchpointhq.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.launchpointhq.com"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "instagram": "https://instagram.com/launchpoint"
    }
  }
}
