{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Launchpoint",
  "colors": {
    "primary": "#7733E1",
    "light": "#7733E1",
    "dark": "#7733E1"
  },
  "favicon": "/favicon.jpeg",
  "navigation": {
    "tabs": [
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "api-reference/openapi.json",
